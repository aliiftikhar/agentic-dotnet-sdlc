{
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh workflow run *)",
      "Bash(gh run rerun *)",
      "Bash(git * --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config --unset core.hooksPath*)"
    ],
    "ask": [
      "Edit(/.github/**)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/hooks/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.codex/**)",
      "Edit(/.agents/agents/**)",
      "Edit(/scripts/**)",
      "Edit(/<ApiProject>/Migrations/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-changes.sh",
            "timeout": 600,
            "statusMessage": "Building changed projects, running unit tests and checking formatting"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spec-check-before-pr.sh",
            "timeout": 60,
            "statusMessage": "Checking the spec and plan match the diff before opening the PR",
            "onFailure": "block"
          },
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/mutation-check-before-pr.sh",
            "timeout": 1800,
            "statusMessage": "Running the mutation check before opening the PR",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-failing-test.sh",
            "timeout": 10,
            "statusMessage": "Checking the edit doesn't change a bug fix's failing test"
          }
        ]
      }
    ]
  }
}
